{
  "name": "vscode-editor-columns",
  "displayName": "VS Code Editor Columns",
  "publisher": "Kooraseru",
  "version": "0.1.0",
  "description": "Adds custom interactive columns and column headers to VS Code's native text editor.",
  "icon": "assets/goofyaah.png",
  "author": {
    "name": "Kooraseru",
    "email": "kooraseru.social@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kooraseru/vscode-editor-columns.git"
  },
  "license": "ISC",
  "engines": {
    "vscode": ">=1.137.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "editor",
    "columns",
    "native editor",
    "interactive cells"
  ],
  "main": "./src/extension.js",
  "types": "./src/api.d.ts",
  "editorColumnsToolchain": {
    "lune": "0.10.5"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vscodeEditorColumns.installWorkbenchBridge",
    "onCommand:vscodeEditorColumns.removeWorkbenchBridge"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeEditorColumns.installWorkbenchBridge",
        "title": "Editor Columns: Install Workbench Bridge"
      },
      {
        "command": "vscodeEditorColumns.removeWorkbenchBridge",
        "title": "Editor Columns: Remove Workbench Bridge"
      }
    ]
  },
  "scripts": {
    "clean": "lune run scripts/clean.luau",
    "compile": "lune run scripts/compile.luau",
    "typecheck": "node scripts/typecheck.cjs",
    "build": "npm run compile && lune run scripts/build.luau",
    "check": "lune run scripts/check.luau",
    "test": "lune run scripts/test.luau",
    "package": "lune run scripts/package.luau",
    "package:built": "lune run scripts/package.luau --from-build",
    "vscode:uninstall": "node ./src/uninstall.js"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/vscode": "1.137.0",
    "@types/ws": "8.18.1",
    "sass": "1.104.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
